{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arqen.dev/schemas/uiir/0.2.0",
  "title": "ARQEN UIIR 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "product", "designSystem", "screens"],
  "properties": {
    "version": { "const": "0.2.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "framework"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "framework": { "enum": ["react", "nextjs", "vite-react", "unknown"] },
        "sourceRoot": { "type": "string", "minLength": 1 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "audience"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "audience": { "type": "array", "items": { "type": "string" } }
      }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tokens"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "category"],
            "properties": {
              "value": { "type": "string" },
              "category": { "enum": ["color", "spacing", "typography", "radius", "shadow", "breakpoint", "other"] }
            }
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/screen" }
    }
  },
  "$defs": {
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "route", "layout", "regions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "pattern": "^/" },
        "layout": { "enum": ["app", "marketing", "auth", "settings", "unknown"] },
        "navigation": { "$ref": "#/$defs/navigation" },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "items"],
      "properties": {
        "mode": { "enum": ["sidebar", "topbar", "bottom-tabs", "none"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/navigationItem" } }
      }
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "route"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "icon": { "type": "string" },
        "route": { "type": "string", "pattern": "^/" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "layout", "components"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["header", "navigation", "content", "aside", "footer"] },
        "layout": { "enum": ["stack", "grid", "split", "freeform"] },
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "semanticRole": { "type": "string" },
        "props": { "type": "object", "additionalProperties": true },
        "children": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "layout": { "$ref": "#/$defs/layout" },
        "typography": { "$ref": "#/$defs/typography" },
        "responsive": { "type": "array", "items": { "$ref": "#/$defs/responsive" } },
        "states": { "type": "array", "items": { "enum": ["default", "loading", "empty", "error", "disabled", "success"] } },
        "interactions": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
        "accessibility": { "$ref": "#/$defs/accessibility" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": { "enum": ["block", "flex", "grid", "absolute", "inline"] },
        "direction": { "enum": ["row", "column"] },
        "gap": { "type": "string" },
        "padding": { "type": "string" },
        "margin": { "type": "string" },
        "width": { "type": "string" },
        "maxWidth": { "type": "string" },
        "columns": { "type": "string" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["display", "heading", "body", "label", "caption"] },
        "size": { "type": "string" },
        "weight": { "type": "string" },
        "lineHeight": { "type": "string" }
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breakpoint", "behavior"],
      "properties": {
        "breakpoint": { "enum": ["mobile", "tablet", "desktop"] },
        "behavior": { "enum": ["stack", "hide", "scroll", "compact", "reflow", "preserve"] },
        "value": { "type": "string" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["click", "submit", "change", "focus", "hover", "navigation"] },
        "target": { "type": "string" },
        "action": { "type": "string" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "keyboard": { "type": "boolean" },
        "labelled": { "type": "boolean" },
        "described": { "type": "boolean" }
      }
    }
  }
}
